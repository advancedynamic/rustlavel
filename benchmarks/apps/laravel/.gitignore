/vendor
/node_modules

# The FrankenPHP static binary Octane downloads: ~170 MB, and re-fetched by
# `php artisan octane:install --server=frankenphp`.
/frankenphp
/caddy

# Generated at start time by run-fpm.sh / run-octane.sh.
/run
/.rr.yaml
/Caddyfile

# Laravel's production caches, rebuilt by `artisan optimize`.
/bootstrap/cache/*.php
/storage/framework/cache/data/*
/storage/framework/views/*
/storage/logs/*
/storage/pail
/database/database.sqlite

*.log
.DS_Store
.env.backup
.env.production
.phpunit.result.cache
/.phpunit.cache
/public/build
/public/hot
/public/storage
Thumbs.db

# NOTE: `.env` is deliberately *not* ignored here. It holds no secret — the
# benchmark database credentials are in benchmarks/CONTRACT.md — and both run
# scripts need it to exist.

# The repository root .gitignore excludes .env. This app is a benchmark, its
# only credentials are the ones printed in benchmarks/CONTRACT.md, and both run
# scripts need the file to exist — so keep it.
!/.env
