APP_NAME=bench-laravel
APP_ENV=production
APP_KEY=base64:dJUyCALPctpBYNseaJ+BhA3+fxKc0gtqq3sMVDm65QU=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# PostgreSQL 16, started by the benchmark harness. The tables already exist and
# are already seeded; never run `artisan migrate` against this database.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55440
DB_DATABASE=bench
DB_USERNAME=bench
DB_PASSWORD=bench

# Nothing in the eight endpoints uses a session, a cache, a queue or the mailer.
# They are pointed at drivers that need no service so a missing Redis or a
# missing cache table can never turn into a request-path cost or a 500.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Laravel Octane. 16 workers to match the 16-connection pool the contract asks
# for: PHP has no connection pool, so one PDO handle per resident worker is the
# closest equivalent.
OCTANE_SERVER=frankenphp
